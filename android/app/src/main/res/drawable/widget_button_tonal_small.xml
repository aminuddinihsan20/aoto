    android:color="#33FFFFFF">
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape>
            <solid android:color="@color/widget_tonal" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</ripple>
