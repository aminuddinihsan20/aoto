<?xml version="1.0" encoding="utf-8"?>
<!-- The 2×2 widget with no cover to show: the cover's place, with the Drop in its middle. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/widget_primary_container" />
            <corners android:radius="@dimen/widget_radius" />
        </shape>
    </item>
    <item
        android:width="72dp"
        android:height="72dp"
        android:drawable="@drawable/widget_drop"
        android:gravity="center" />
</layer-list>
