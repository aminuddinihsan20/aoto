<?xml version="1.0" encoding="utf-8"?>
<!-- The 4×1 widget; see widget_wide_info.xml for what the numbers are. It only grows sideways: the pill keeps its height. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_pill_description"
    android:initialLayout="@layout/widget_pill"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="40dp"
    android:previewImage="@drawable/widget_pill_preview"
    android:previewLayout="@layout/widget_pill"
    android:resizeMode="horizontal"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
