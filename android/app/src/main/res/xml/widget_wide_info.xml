<?xml version="1.0" encoding="utf-8"?>
<!-- The 4×2 widget. The sizes in dp are for launchers below Android 12 (4 cells by 2 by the old rule of 70 a cell less 30); from 12 on the cell counts, the description and the layout as preview are used. No update period: PlaybackService says when something changed. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_wide_description"
    android:initialLayout="@layout/widget_wide"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="240dp"
    android:minResizeHeight="110dp"
    android:previewImage="@drawable/widget_wide_preview"
    android:previewLayout="@layout/widget_wide"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
