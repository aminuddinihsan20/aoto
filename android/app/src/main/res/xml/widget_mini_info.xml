<?xml version="1.0" encoding="utf-8"?>
<!-- The 2×1 widget; see widget_wide_info.xml for what the numbers are. It only grows sideways: the pill keeps its height. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_mini_description"
    android:initialLayout="@layout/widget_mini"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:previewImage="@drawable/widget_mini_preview"
    android:previewLayout="@layout/widget_mini"
    android:resizeMode="horizontal"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
