<?xml version="1.0" encoding="utf-8"?>
<!-- The 4×3 widget: the song that plays (cover, title, artist, play / pause, progress)
     and "Up next", the songs after it; a tap on one plays it. As written here it is the
     widget with no song (and the widget picker's preview). NowPlayingWidget puts as many
     rows (widget_queue_row.xml) into widget_rows as WidgetLogic.queueRows finds room
     for, which counts with the heights here: change them together. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/widget_art_clip_small"
            android:clipToOutline="true"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_art_empty" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_empty_title"
                android:textColor="@color/widget_on_surface"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_empty_text"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_toggle"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_button_primary"
            android:contentDescription="@string/widget_play"
            android:src="@drawable/ic_widget_play" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progressDrawable="@drawable/widget_progress"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/widget_up_next"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginTop="10dp"
        android:includeFontPadding="false"
        android:letterSpacing="0.05"
        android:maxLines="1"
        android:text="@string/widget_up_next"
        android:textAllCaps="true"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_queue_end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_queue_end"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />
</LinearLayout>
