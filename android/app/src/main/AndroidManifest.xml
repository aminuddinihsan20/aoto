<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Also what tells Wi-Fi from mobile data, for downloads set to "Wi-Fi only". -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Music keeps playing with the app away: a media notification (service) and the
         CPU awake for it. Notifications need asking for on Android 13+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Saving a lyric card to Pictures: Android 10 and later take it through the media
         store with no permission; before that the folder is written to directly. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- "Play on" opens Android's own output switcher, which the System UI (Android 12
         and 13) or the Settings app (10 and 11) shows when asked; and the Bluetooth
         settings where there is none. The app checks that a system app answers first. -->
    <queries>
        <intent>
            <action android:name="com.android.systemui.action.LAUNCH_MEDIA_OUTPUT_DIALOG" />
        </intent>
        <intent>
            <action android:name="com.android.settings.panel.action.MEDIA_OUTPUT" />
        </intent>
        <intent>
            <action android:name="android.settings.BLUETOOTH_SETTINGS" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Aoto"
        android:allowBackup="false">

        <!-- configChanges: rotation, font size, language and the like reach the app as
             changes instead of restarting the activity, which the Rust app (one event
             loop per process) can't follow. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density|locale|layoutDirection|fontScale|fontWeightAdjustment|navigation|touchscreen|colorMode|mcc|mnc|grammaticalGender"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.app.lib_name"
                android:value="aoto_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Play … on Aoto", said to the Assistant: with a car connected that goes
                 to the media session; without one Android opens the app with it. Android
                 Auto expects a media app to declare it. -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Android Auto: the app is a media app (automotive_app_desc), and this is the
             service a car connects to, to browse and to get the media session. Exported
             for that; the service itself lets only the system, system apps and Android
             Auto in (AutoLogic.allowed). -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <!-- The app's small one-colour icon beside what plays: under the name Android Auto
             reads now, and the one it read before. -->
        <meta-data
            android:name="androidx.car.app.TintableAttributionIcon"
            android:resource="@drawable/ic_stat_music" />
        <meta-data
            android:name="com.google.android.gms.car.notification.SmallIcon"
            android:resource="@drawable/ic_stat_music" />
        <service
            android:name=".AutoBrowserService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- The home-screen widgets (4×2, 2×2, 4×1, 2×1, 4×3): one receiver each, since each has its
             own sizes; the label is the widget's name in the widget picker. -->
        <receiver
            android:name=".NowPlayingWidget$Wide"
            android:exported="false"
            android:label="@string/widget_wide_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_wide_info" />
        </receiver>
        <receiver
            android:name=".NowPlayingWidget$Cover"
            android:exported="false"
            android:label="@string/widget_cover_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_cover_info" />
        </receiver>
        <receiver
            android:name=".NowPlayingWidget$Pill"
            android:exported="false"
            android:label="@string/widget_pill_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_pill_info" />
        </receiver>
        <receiver
            android:name=".NowPlayingWidget$Mini"
            android:exported="false"
            android:label="@string/widget_mini_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_mini_info" />
        </receiver>
        <receiver
            android:name=".NowPlayingWidget$Queue"
            android:exported="false"
            android:label="@string/widget_queue_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_queue_info" />
        </receiver>
        <!-- Sharing a lyric card: other apps read the picture through this, and only the
             pictures in the cache's "share" folder (res/xml/share_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>

        <!-- The sign-in page (a WebView), opened by MainActivity when the app asks. -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density|locale|layoutDirection|fontScale"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
