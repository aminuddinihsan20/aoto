<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Also what tells Wi-Fi from mobile data, for downloads set to "Wi-Fi only". -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Music keeps playing with the app away: a media notification (service) and the
         CPU awake for it. Notifications need asking for on Android 13+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.BitChord"
        android:allowBackup="false">

        <!-- configChanges: rotation, font size, language and the like reach the app as
             changes instead of restarting the activity, which the Rust app (one event
             loop per process) can't follow. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density|locale|layoutDirection|fontScale|fontWeightAdjustment|navigation|touchscreen|colorMode|mcc|mnc|grammaticalGender"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.app.lib_name"
                android:value="bitchord_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- The sign-in page (a WebView), opened by MainActivity when the app asks. -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density|locale|layoutDirection|fontScale"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
